NODE_ENV=production
HOST=0.0.0.0
PORT=3001
MONGODB_URI=
SESSION_SECRET=
LINK_SECRET=
APP_ORIGIN=https://your-domain.example
# Set to the actual trusted proxy IP/CIDR. Restrict network access to that proxy.
# Same-host nginx with host networking: 127.0.0.1/32,::1/128
TRUST_PROXY_CIDRS=
RESEND_API_KEY=
RESEND_FROM=
AWS_REGION=ap-south-1
S3_BUCKET=
# Vercel: restricted photo-storage role trusted through Vercel OIDC.
# No AWS_PROFILE or long-lived AWS keys are needed with this role.
AWS_ROLE_ARN=
# Omit AWS_PROFILE and AWS access keys on AWS: attach a restricted IAM role.
GOOGLE_PLACES_API_KEY=
GOOGLE_TRANSLATION_API_KEY=
PLATFORM_MODERATOR_USER_IDS=
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=
TERMS_URL=

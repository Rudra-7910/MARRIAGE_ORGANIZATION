NODE_ENV=development
HOST=127.0.0.1
PORT=3001
MONGODB_URI=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
# Optional: comma-separated trusted reverse-proxy IPs/subnets. Empty = trust none.
# Set to your actual proxy addresses before AWS TLS termination; never use /0.
TRUST_PROXY_CIDRS=
# Invitations: configure a sender using your verified Resend domain.
RESEND_API_KEY=
RESEND_FROM=

# Keep this stable. Defaults to SESSION_SECRET when omitted.
# Set a separate random 32+ character value before sharing invitation/QR links.
LINK_SECRET=
# One PRIVATE AWS S3 bucket. Keep Block Public Access enabled and ACLs disabled.
AWS_REGION=ap-south-1
S3_BUCKET=
# Local development: SDK loads the named AWS CLI profile, outside this repository.
# On AWS, omit AWS_PROFILE and use the backend's IAM role instead.
AWS_PROFILE=
# Optional integrations. Keys remain on Express, never in VITE_* variables.
GOOGLE_PLACES_API_KEY=
GOOGLE_TRANSLATION_API_KEY=
# Explicit User ObjectIds with platform content-moderator access, comma separated.
# Wedding Admin/Organizer roles do not grant platform-wide moderation.
PLATFORM_MODERATOR_USER_IDS=

# Public support/legal links shown in the footer. HTTPS policy URLs only.
# Supply the actual operator's reviewed policies before a public launch.
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=
TERMS_URL=

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
MONGODB_URI=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
# Optional: comma-separated trusted reverse-proxy IPs/subnets. Empty = trust none.
# Set to your actual proxy addresses before AWS TLS termination; never use /0.
TRUST_PROXY_CIDRS=
# Invitations: configure a sender using your verified Resend domain.
RESEND_API_KEY=
RESEND_FROM=
